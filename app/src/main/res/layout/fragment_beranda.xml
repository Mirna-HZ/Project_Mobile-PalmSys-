<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Beranda.BerandaFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/plum_utama"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Header gelombang (background drawable) di belakang kartu saldo -->
            <View
                android:id="@+id/viewHeader"
                android:layout_width="0dp"
                android:layout_height="230dp"
                android:background="@drawable/bg_header_beranda"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSaldo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/plum_utama"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Background kartu memakai drawable bg_kartu_saldo -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu_saldo"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textHalo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Halo"
                        android:textColor="@color/lilac_muda"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textLabelSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/label_saldo"
                        android:textColor="@color/lilac_muda"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textHalo" />

                    <TextView
                        android:id="@+id/textSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito_black"
                        android:text="@string/isi_saldo"
                        android:textColor="@color/white"
                        android:textSize="30sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textLabelSaldo" />

                    <TextView
                        android:id="@+id/textKetSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/ket_saldo"
                        android:textColor="@color/lilac_muda"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textSaldo" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textLabelMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/label_menu"
                android:textColor="@color/teks_utama"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSaldo" />

            <!-- Menu grid 3 kolom x 2 baris, gaya tombol sama dengan halaman Akun -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                app:columnCount="3"
                app:useDefaultMargins="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textLabelMenu">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuCatat"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_catat"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_catat"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuKantong"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_kantong"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_kantong"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuStatistik"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_statistik"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_statistik"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuAkun"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_akun"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_akun"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuGapki"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_gapki"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_public"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuProfil"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:backgroundTint="@color/lilac_muda"
                    android:fontFamily="@font/inter_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/menu_profil"
                    android:textColor="@color/plum_utama"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconTint="@color/plum_utama"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

            </androidx.gridlayout.widget.GridLayout>

            <TextView
                android:id="@+id/textLabelAktivitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/label_aktivitas"
                android:textColor="@color/teks_utama"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/gridMenu" />

            <!-- Daftar aktivitas memakai RecyclerView (kartu sama dengan desain asli) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAktivitas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textLabelAktivitas"
                tools:listitem="@layout/item_transaksi" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
